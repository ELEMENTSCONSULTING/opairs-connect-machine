# Kopieren nach .env und anpassen. .env gehoert NICHT ins Repository.
# Passwoerter bitte nur mit URL-sicheren Zeichen (Buchstaben, Ziffern, - _ .),
# weil sie in der Datenbank-URL des Connectors stehen.

# Datenbank (Admin-Zugang, nur fuer Wartung und Setup)
POSTGRES_USER=opairs
POSTGRES_PASSWORD=bitte-aendern-admin
POSTGRES_DB=opairs

# Connector darf nur schreiben, Superset darf nur lesen
OPAIRS_WRITER_PASSWORD=bitte-aendern-writer
OPAIRS_READER_PASSWORD=bitte-aendern-reader

# Welche Pipeline laeuft (Datei aus ./pipelines, Pfad im Container)
PIPELINE=/etc/opairs/pipelines/selftest.yaml
# PIPELINE=/etc/opairs/pipelines/opcua-to-postgres.yaml
# PIPELINE=/etc/opairs/pipelines/ifm-to-postgres.yaml
# PIPELINE=/etc/opairs/pipelines/demo-anlage.yaml

# Quelle (nur fuer die OPC-UA-Pipeline relevant)
MACHINE_NAME=machine-01
OPCUA_ENDPOINT=opc.tcp://host.docker.internal:4840

# ifm IO-Link-Master (nur fuer die ifm-Pipeline)
IFM_MASTER_ADDRESS=192.168.0.1
# IODDs vom lokalen Mirror (Standard). Nur aendern, wenn bewusst eine andere
# Quelle genutzt werden soll.
# IODD_API=http://iodd-mirror:8080

# Datenbank fuer Superset freigeben (nur mit compose.override.yaml, siehe dort)
# DB_BIND_ADDRESS=10.0.0.5
# DB_PORT=55432

# Superset auf demselben Host: Datenbank in das Superset-Netz haengen
# (siehe compose.superset.yaml)
# SUPERSET_NETWORK=docker_db-net
# COMPOSE_FILE=compose.yaml:compose.superset.yaml

# Aufbewahrung
RAW_RETENTION_DAYS=30
AGG_RETENTION_DAYS=400

# Optional: Versionsstring im Image
# APP_VERSION=0.1.0
