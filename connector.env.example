# Variablen fuer die Connector-Pipelines (nur die der verwendeten Pipeline setzen).
#   cp connector.env.example connector.env
#   docker compose up -d && docker compose restart connector
# connector.env ist nicht eingecheckt. Passwoerter gehoeren hierher, nicht in die Pipeline-Datei.
# MACHINE_NAME, OPCUA_ENDPOINT, IFM_MASTER_ADDRESS und PIPELINE stehen weiter in .env.

# Siemens S7 (pipelines/vorlagen/s7-to-postgres.yaml)
# S7_ADDRESS=192.168.0.1
# S7_RACK=0
# S7_SLOT=1
# S7_INTERVAL=1s

# Modbus TCP (pipelines/vorlagen/modbus-to-postgres.yaml)
# MODBUS_ADDRESS=tcp://192.168.0.10:502
# MODBUS_SLAVE_ID=1
# MODBUS_INTERVAL=1s

# EtherNet/IP (pipelines/vorlagen/ethernetip-to-postgres.yaml)
# EIP_ADDRESS=192.168.0.20:44818
# EIP_POLL_MS=1000

# Beckhoff ADS (pipelines/vorlagen/ads-to-postgres.yaml)
# ADS_ADDRESS=192.168.1.100
# ADS_RUNTIME_PORT=851
# ADS_HOST_IP=192.168.1.50
# ADS_USERNAME=
# ADS_PASSWORD=

# Sparkplug B (pipelines/vorlagen/sparkplug-to-postgres.yaml)
# MQTT_URL=tcp://mqtt-broker:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# SPARKPLUG_GROUP=Werk

# Mehrere OPC-UA-Server (pipelines/vorlagen/mehrere-anlagen-opcua.yaml)
# OPCUA_ENDPOINT_1=opc.tcp://anlage1:4840
# OPCUA_ENDPOINT_2=opc.tcp://anlage2:4840
